# requirements-types.in
# Type checking dependencies for MyPy pre-commit hook
# This file provides deterministic type checking environment separate from runtime dependencies
# Usage: pip-compile requirements-types.in --output-file requirements-types.txt

# === Core Type Stubs (Required) ===
# Essential type stubs for standard library and core dependencies
types-PyYAML>=6.0.0
pandas-stubs==2.3.0.250703  # Matches pandas==2.3.1 in runtime
typing-extensions>=4.7.0

# === Runtime Dependency Type Stubs ===
# Type stubs for runtime dependencies used in type-checked code
types-psutil  # For health_check.py, monitoring_service.py, dashboard_service.py
types-redis   # For dashboard_backend.py
types-requests  # For HTTP client usage
types-setuptools  # For setup/packaging utilities

# === Optional Dependencies (Install Conditionally) ===
# These are installed when available in environment for better type checking
# When not installed, MyPy will still work but with reduced type safety

# Time series database
influxdb-client>=1.36.0  # For logger_service.py, influxdb_client.py, kraken_historical_data_service.py

# Cloud storage backends
aioboto3>=11.0.0  # For model_lifecycle/cloud_storage.py, risk_manager.py
boto3-stubs[essential]  # Type stubs for boto3/aioboto3
google-cloud-storage>=2.0.0  # For model_lifecycle/cloud_storage.py

# Cryptography for secrets management
cryptography>=41.0.0  # For utils/secrets_manager.py

# Database migrations
alembic>=1.10.0  # For dal/migrations/migration_manager.py

# Production web server
uvicorn[standard]>=0.23.0  # For monitoring/run_dashboard.py

# Machine learning optional dependencies
xgboost>=1.7.0  # For predictors/xgboost_predictor.py
scikit-learn>=1.3.0  # For feature_imputation.py KNNImputer

# Enhanced technical analysis
TA-Lib>=0.4.25  # For technical analysis implementations

# Email/SMS notifications
sendgrid>=6.10.0  # For monitoring/alerting_system.py
twilio>=8.5.0  # For monitoring/alerting_system.py

# Additional file I/O
aiofiles>=23.0.0  # For model_lifecycle/cloud_storage.py

# === Development and Testing Type Dependencies ===
# Type stubs for testing and development tools (used in test files)
types-mock
types-jsonschema

# === Constraint Comments ===
# influxdb-client: Required for time series data logging and storage
# aioboto3/boto3-stubs: Required for AWS S3 model storage backend
# google-cloud-storage: Required for Google Cloud Storage backend
# cryptography: Required for encrypted secrets management
# alembic: Required for database schema migrations
# uvicorn: Required for production dashboard deployment
# xgboost: Optional ML predictor backend
# scikit-learn: Required for KNN imputation features
# TA-Lib: Optional technical analysis backend (faster than pandas-ta)
# sendgrid/twilio: Optional alerting backends
# aiofiles: Required for async file operations in cloud storage
